# Application
NODE_ENV=development
APP_NAME=multi-vendor-delivery-platform
PORT=4000
API_PREFIX=api
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000

# MongoDB
DATABASE_URL=mongodb://localhost:27017/multi_vendor_delivery?replicaSet=rs0&directConnection=true

# Authentication
# Replace every secret outside local development.
JWT_ACCESS_TOKEN_SECRET=local-access-secret-change-before-production-0001
JWT_ACCESS_TOKEN_EXPIRATION_TIME=15m
JWT_REFRESH_TOKEN_SECRET=local-refresh-secret-change-before-production-0001
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d
JWT_VERIFICATION_TOKEN_SECRET=local-verification-secret-change-before-production-0001
JWT_VERIFICATION_TOKEN_EXPIRATION_TIME=15m
GUEST_EMAIL=guest@example.invalid

# Email is optional for local startup. Add development SMTP credentials when
# exercising verification and password-reset flows.
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASSWORD=

# Logging
LOG_LEVEL=debug
LOG_DIR=logs
